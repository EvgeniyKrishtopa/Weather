# Required for current weather requests.
VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# Optional. Leave empty to use local fallback outfit recommendations.
# For `npm run outfit-worker:dev`, use:
# VITE_OUTFIT_RECOMMENDATION_API_URL=http://localhost:8787/recommend-outfit
VITE_OUTFIT_RECOMMENDATION_API_URL=
